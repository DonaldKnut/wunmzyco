# Database (PostgreSQL)
# Local embedded Postgres: npm run db:embedded (default port 5432, or set PG_PORT)
DATABASE_URL=postgresql://postgres:postgres@localhost:15432/wunmzyco?schema=public

# Public site URL used for canonical links and payment callbacks
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Auth — generate with: openssl rand -base64 32
AUTH_SECRET=

# One-time admin bootstrap token for `npm run admin:bootstrap`
ADMIN_SETUP_TOKEN=

# Payment provider: "paystack" | "mock"
# For live checkout: PAYMENT_PROVIDER=paystack and paste keys from https://dashboard.paystack.com/#/settings/developer
# - PAYSTACK_SECRET_KEY: sk_test_… or sk_live_… (server only — never expose in the browser)
# - NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY: pk_test_… or pk_live_… (optional; used if you add inline JS)
# - PAYSTACK_WEBHOOK_SECRET: optional; defaults to secret key for signature verification
# mock is for local development only and is blocked in production
PAYMENT_PROVIDER=mock
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
# test | live
PAYSTACK_MODE=test

# Email provider: "resend" | "console"
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=Wunmzy Co <orders@wunmzyco.com>

# Image storage: Cloudinary only — every picture uploaded on the site
# (products, homepage slides, categories, collections, logo/favicon) goes to
# Cloudinary. There is no local-disk fallback; uploads fail if these are unset.
# Get them from Cloudinary Dashboard → Settings → API Keys:
# 1) STORAGE_PROVIDER=cloudinary
# 2) CLOUDINARY_CLOUD_NAME=your-cloud-name
# 3) CLOUDINARY_API_KEY=…
# 4) CLOUDINARY_API_SECRET=… (never commit real secrets)
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Protects GET/POST /api/cron/release-reservations
CRON_SECRET=

# Optional: Node environment
NODE_ENV=development
