# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wunmzyco?schema=public

# Public site URL used for canonical links and payment callbacks
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Auth — generate with: openssl rand -base64 32
AUTH_SECRET=

# One-time admin bootstrap token for `npm run admin:bootstrap`
ADMIN_SETUP_TOKEN=

# Payment provider: "paystack" | "mock"
# mock is for local development only and is blocked in production
PAYMENT_PROVIDER=mock
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
# test | live
PAYSTACK_MODE=test

# Email provider: "resend" | "console"
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=Wunmzy Co <orders@wunmzyco.com>

# Image storage: "cloudinary" | "local"
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Protects GET/POST /api/cron/release-reservations
CRON_SECRET=

# Optional: Node environment
NODE_ENV=development
